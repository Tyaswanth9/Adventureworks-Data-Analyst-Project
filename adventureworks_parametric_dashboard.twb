      <column caption='date' datatype='date' name='[Calculation_1148417921077891072]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(&#13;&#10;LEFT(STR([OrderDateKey]),4)+&quot;-&quot;+&#13;&#10;MID(STR([OrderDateKey]),5,2)+&quot;-&quot;+&#13;&#10;RIGHT(STR([OrderDateKey]),2)&#13;&#10;)' />
      </column>
      <column caption='year-month' datatype='string' name='[Calculation_1148417921078120449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(year([Calculation_1148417921077891072]))+&quot;-&quot;+&#13;&#10;datename(&apos;month&apos;,([Calculation_1148417921077891072]))' />
      </column>
      <column caption='month name' datatype='string' name='[Calculation_1148417921078358018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datename(&apos;month&apos;,[Calculation_1148417921077891072])' />
      </column>
      <column caption='month number' datatype='string' name='[Calculation_1148417921078558723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(month([Calculation_1148417921077891072]))' />
      </column>
      <column caption='week day name' datatype='string' name='[Calculation_1148417921079033860]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[Calculation_1148417921077891072])' />
      </column>
      <column caption='Quarter number' datatype='string' name='[Calculation_1148417921079656454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if MONTH([Calculation_1148417921077891072])&lt;=3 THEN &quot;Quarter_1&quot; &#13;&#10;ELSE&#13;&#10;if MONTH([Calculation_1148417921077891072])&lt;=6 THEN &quot;Quarter_2&quot; &#13;&#10;ELSE&#13;&#10;if MONTH([Calculation_1148417921077891072])&lt;=9 THEN &quot;Quarter_3&quot; &#13;&#10;ELSE &quot;Quarter_4&quot;&#13;&#10;END&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='fisical_month' datatype='string' name='[Calculation_1148417921082556423]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Calculation_1148417921078558723]&#13;&#10;WHEN &quot;4&quot; THEN &quot;fisical month 01&quot;&#13;&#10;WHEN &quot;5&quot; THEN &quot;fisical month 02&quot;&#13;&#10;WHEN &quot;6&quot; THEN &quot;fisical month 03&quot;&#13;&#10;WHEN &quot;7&quot; THEN &quot;fisical month 04&quot;&#13;&#10;WHEN &quot;8&quot; THEN &quot;fisical month 05&quot;&#13;&#10;WHEN &quot;9&quot; THEN &quot;fisical month 06&quot;&#13;&#10;WHEN &quot;10&quot; THEN &quot;fisical month 07&quot;&#13;&#10;WHEN &quot;11&quot; THEN &quot;fisical month 08&quot;&#13;&#10;WHEN &quot;12&quot; THEN &quot;fisical month 09&quot;&#13;&#10;WHEN &quot;1&quot; THEN &quot;fisical month 10&quot;&#13;&#10;WHEN &quot;2&quot; THEN &quot;fisical month 11&quot;&#13;&#10;WHEN &quot;3&quot; THEN &quot;fisical month 12&quot;&#13;&#10;END' />
      </column>
      <column caption='fisical_quarter' datatype='string' name='[Calculation_1148417921083547656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;, [Calculation_1148417921077891072]) = 1 THEN &apos;FQ 4&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Calculation_1148417921077891072]) = 2 THEN &apos;FQ 1&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Calculation_1148417921077891072]) = 3 THEN &apos;FQ 2&apos;&#13;&#10;ELSE &apos;FQ 3&apos;&#13;&#10;END' />
      </column>
      <column caption='Sales' datatype='real' name='[Calculation_1148417921085390857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([SalesAmount])' />
      </column>
      <column caption='Total orders' datatype='integer' name='[Calculation_293296941933625344]' role='measure' type='quantitative'>
